# ─────────────────────────────────────────────────────────────
# AgendaMed — Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Obtén estos valores en: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...TU_ANON_KEY
# IMPORTANTE: Esta clave tiene permisos de super-admin. Solo úsala en el servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJh...TU_SERVICE_ROLE_KEY

# ── URL de la aplicación ──────────────────────────────────────
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com  ← CAMBIAR OBLIGATORIO
# Se usa en: links de cancelación en emails, redirect de Zoom OAuth
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (correos transaccionales) ─────────────────────────
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_...TU_API_KEY
# El remitente debe estar verificado en Resend como dominio o email
RESEND_FROM=AgendaMed <noreply@agendamed.mx>

# ── Twilio (WhatsApp / SMS recordatorios) ────────────────────
# Obtén estos valores en: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=AC...TU_SID
TWILIO_AUTH_TOKEN=TU_AUTH_TOKEN
# Número de sandbox de WhatsApp en desarrollo: whatsapp:+14155238886
# En producción usar el número aprobado de WhatsApp Business
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Zoom OAuth (teleconsultas) ───────────────────────────────
# Crear una app "OAuth" en: https://marketplace.zoom.us/develop/create
# Redirect URI debe ser exactamente: NEXT_PUBLIC_APP_URL + /api/zoom/callback
ZOOM_CLIENT_ID=TU_CLIENT_ID
ZOOM_CLIENT_SECRET=TU_CLIENT_SECRET
ZOOM_REDIRECT_URI=http://localhost:3000/api/zoom/callback

# ── Admin ─────────────────────────────────────────────────────
# NOTA: Actualmente los emails de admin están hardcodeados en el código:
#   app/admin/page.tsx
#   app/admin/consultorios/[id]/page.tsx
#   app/api/admin/consultorio/[id]/route.ts
# Pendiente: mover a esta variable de entorno antes del deploy a producción.
ADMIN_EMAILS=admin@agendamed.mx,silvaalfonso381@gmail.com

# ── Cron jobs (recordatorios y cumpleaños automáticos) ───────
# Genera un string aleatorio largo. Vercel lo envía como header x-cron-secret.
# En Vercel Dashboard → Settings → Environment Variables
CRON_SECRET=tu_secret_cron_aleatorio_largo

# ── App Secret ───────────────────────────────────────────────
APP_SECRET=tu_secret_aleatorio_minimo_32_caracteres
